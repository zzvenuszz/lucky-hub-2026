# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/lucky_hub

# ImgBB API Key (For image uploads)
IMGBB_API_KEY=

# Google Gemini API Keys
API_KEY=
API_KEY_2=
API_KEY_3=
GEMINI_API_KEY=

# Optional: Gemini API Proxy (Khuyên dùng nếu chạy trên Render để bypass Location Block)
# Ví dụ: https://proxy.yourdomain.com/v1beta
GEMINI_PROXY_URL=

# Port
PORT=3000
NODE_ENV=production
